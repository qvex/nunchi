# Discord: bot token from https://discord.com/developers/applications, and YOUR user ID
# (Discord settings > Advanced > Developer Mode, then right-click your name > Copy User ID)
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# LLM providers (leave a key empty to skip that provider; agents using it will fail over to OpenRouter)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Postgres (docker compose maps it to localhost:5433)
DATABASE_URL=postgres://assistant:assistant@localhost:5433/assistant

# Names to mask before text is sent to any LLM, comma separated (e.g. your full name, family names)
OWNER_NAMES=

# Job sources (optional; each source is skipped when its keys are empty)
# Adzuna: https://developer.adzuna.com  (covers India + several EU countries)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch via RapidAPI: https://rapidapi.com/letscrunch/api/jsearch  (used for South Korea + Japan)
JSEARCH_API_KEY=
